{
  "schemaVersion": 1,
  "id": "mcmod",
  "version": "${version}",
  "name": "McMod",
  "description": "Add task for toolsmith and weaponsmith to repair iron and copper golems.",
  "authors": [
    "Sebastian Hasait"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/mcmod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.hasait.mcmod.McMod"
    ],
    "client": [
      "de.hasait.mcmod.client.McModClient"
    ]
  },
  "mixins": [
    "mcmod.mixins.json",
    {
      "config": "mcmod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
